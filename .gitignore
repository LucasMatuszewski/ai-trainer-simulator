# Node
node_modules/
dist/
.pnpm-store/

# Build / cache
.vite/
.turbo/
*.tsbuildinfo

# IDE
.vscode/
.idea/
.DS_Store

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Agent work (kept in repo for history but gitignored from commits; can be reviewed locally)
.agent-briefs/*.output
.agent-briefs/*.stderr

# Playwright / debug
.playwright-mcp/
.playwright-cli/
test-results/
playwright-report/

# QA / debugging screenshots - NEVER committed.
#
# Lucas, 2026-09-03: "we should ignore screens from QA everywhere. Only
# used inside game images are allowed, but probably should stay in
# assets." Nothing under a screenshots/ directory is a game asset: the
# game draws itself from procedural geometry and canvas textures, and
# real runtime assets live under public/assets/ (audio today).
#
# `screenshots/` has no leading slash, so it matches at ANY depth - it
# covers both screenshots/ and tests/e2e/screenshots/.
office-*.png
canvas-element.png
screenshots/

# OS temp
Thumbs.db

# Compiled JS next to TS (we ship TS only; Vite compiles at build)
src/**/*.js
src/**/*.js.map
!src/**/*.config.js

# Compiled test JS next to TS (vitest type-checks .ts directly)
tests/**/*.js
tests/**/*.js.map

# Env
.env
.env.local
.normalized/

# Stray verification screenshots dropped in the repo root by agents
# (Lucas: "do not commit all these png! ignore them in git, but don't
# delete"). As of 2026-09-03 NO image is tracked anywhere in the repo,
# so this no longer needs the "tracked screenshots are unaffected"
# caveat it used to carry - the rules above already cover every
# screenshot directory.
/*.png
