# Node
node_modules/
dist/
.pnpm-store/

# Build / cache
.vite/
.turbo/
*.tsbuildinfo

# IDE
.vscode/
.idea/
.DS_Store

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Agent work (kept in repo for history but gitignored from commits; can be reviewed locally)
.agent-briefs/*.output
.agent-briefs/*.stderr

# Playwright / debug
.playwright-mcp/
test-results/
playwright-report/

# Throwaway screenshots from local debugging
office-*.png
canvas-element.png
screenshots/

# OS temp
Thumbs.db

# Compiled JS next to TS (we ship TS only; Vite compiles at build)
src/**/*.js
src/**/*.js.map
!src/**/*.config.js

# Compiled test JS next to TS (vitest type-checks .ts directly)
tests/**/*.js
tests/**/*.js.map

# Env
.env
.env.local
.normalized/

# Stray verification screenshots dropped in the repo root by agents
# (Lucas: "do not commit all these png! ignore them in git, but don't
# delete"). Tracked screenshots under tests/e2e/screenshots/ and
# screenshots/ are unaffected - root-level patterns only.
/*.png
